  "structures": [
    {"id": "not-but", "regex": "不是[^。！？!?\\n]{1,24}[，,]?\\s*而是", "name": "「不是 A，而是 B」", "fix": "直接说 B。先立一个靶子再推倒，是最典型的中文 AI 腔。"},
    {"id": "not-only", "regex": "(不仅|不只|不单)[^。！？!?\\n]{1,30}(而且|更是|还能|也能|更能)", "name": "「不仅……而且/更……」", "fix": "拆成两句，或者删掉弱的那一半。"},
    {"id": "not-just-more", "regex": "不(仅仅|只)是[^。！？!?\\n]{1,24}[，,]?\\s*(更|而)是", "name": "「这不仅仅是……更是……」", "fix": "说你真正想说的那一件事。"},
    {"id": "rather", "regex": "与其(说)?[^。！？!?\\n]{1,24}不如", "name": "「与其……不如……」", "fix": "直接说结论。"},
    {"id": "rhetorical", "regex": "(^|[。！？!?\\n])\\s*(结果呢[？?]|答案是[：:]|原因很简单|那么问题来了|你没看错|划重点[：:]?)", "name": "设问自答 / 播音腔转场", "fix": "删掉转场，直接给答案。"},
    {"id": "hope-helps", "regex": "希望(这篇|本文|以上|这些|这个|今天)[^。！？\\n]{0,14}(帮助|有用|有帮助)", "name": "「希望对你有帮助」式结尾", "fix": "删。结尾给一个具体的下一步。"},
    {"id": "ending-cta", "regex": "(你学会了吗|快去试试|赶紧(用|试)起来|评论区(告诉|聊聊|见|留言)|有问题(欢迎)?(在)?评论区|关注我[，,]?(不迷路|获取|学习|带你))", "name": "模板式结尾三件套", "fix": "删。小红书读者一眼认得出这是模板。"},
    {"id": "opener-today", "regex": "^\\s*(大家好|哈喽|嗨[，,]|今天(给大家|来|和大家|我们|跟大家)?(分享|聊聊|介绍|讲讲|说说))", "name": "开场白", "fix": "删。第一句写读者正在经历的场景。"},
    {"id": "identity", "regex": "(我是(一名|一个|个)?[^，。！？\\n]{0,12}(工程师|程序员|开发者|博主|从业者|做[^，。！？\\n]{1,10}的))|作为一名", "name": "自我介绍 / 身份句", "fix": "删。可信度靠洞察、原文和踩过的坑，不靠身份。"},
    {"id": "lets", "regex": "让我们(一起)?(来)?(看看|了解|探索|深入|走进)", "name": "「让我们一起来看看」", "fix": "删，直接开始讲。"},
    {"id": "markdown", "regex": "\\*\\*[^*\\n]+\\*\\*|(?m)^#{1,6}\\s|```", "name": "Markdown 残留", "fix": "小红书正文不渲染 Markdown，星号和井号会原样显示。"},
    {"id": "exclaim-stack", "regex": "[！!]{2,}", "name": "连续感叹号", "fix": "留一个，或者都删。"}
  ]
}
