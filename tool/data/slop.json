{
  "version": "1.0",
  "note": "去 AI 腔词库，xhs human 和 xhs detect 共用。中文改写要看整句，所以大部分词条只标记（flag）不硬换；只有删掉后句子仍然通顺的填充语才自动删（delete）。最后几个 family 是小红书特有的：网感套话、模板式结尾、标题党。这份文件是给你改的：你自己常用、觉得不算 AI 腔的词，直接删掉那一条。",
  "typographic": [
    {"find": "——", "name": "中文破折号", "to": "，", "note": "AI 中文最爱用破折号引出解释。改成逗号，或者干脆拆成两句。"},
    {"find": "—", "name": "单个破折号", "to": "，", "note": "中文里单个 — 本来就不规范。"}
  ],
  "rewrites": [
    {"id": "era-opener", "regex": "在当今(这个)?[^，。！？\\n]{0,14}(时代|社会|世界|浪潮|背景下)[，,]?", "replace": "", "name": "「在当今……时代」开头"},
    {"id": "with-dev", "regex": "随着[^，。！？\\n]{2,18}的(不断|快速|飞速|迅猛|持续)?(发展|普及|进步|演进|迭代)[，,]?", "replace": "", "name": "「随着……的发展」开头"},
    {"id": "jinxing", "regex": "进行(了)?(优化|测试|分析|讨论|处理|调整|配置|修改|部署|对比|验证|检查|总结|学习|尝试)", "replace": "${2}${1}", "name": "「进行优化」→「优化」"},
    {"id": "nenggou", "regex": "能够", "replace": "能", "name": "「能够」→「能」"},
    {"id": "tongguo-shiyong", "regex": "通过使用", "replace": "用", "name": "「通过使用」→「用」"},
    {"id": "keyishuoshi", "regex": "可以说是", "replace": "算是", "name": "「可以说是」→「算是」"}
  ],
